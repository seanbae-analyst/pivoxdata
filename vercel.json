{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://pivoxquant.com https://*.pivoxquant.com"
        }
      ]
    },
    {
      "source": "/(.*).mjs",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/trends",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/research/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/maps/:path*",
      "destination": "/map",
      "permanent": true
    },
    {
      "source": "/maps",
      "destination": "/map",
      "permanent": true
    },
    {
      "source": "/check",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/analysis",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/analysis-kr",
      "destination": "/",
      "permanent": true
    }
  ]
}
