{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*).mjs",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/javascript; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/trends",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/research/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/maps/:path*",
      "destination": "/map",
      "permanent": true
    },
    {
      "source": "/maps",
      "destination": "/map",
      "permanent": true
    },
    {
      "source": "/check",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/analysis",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/analysis-kr",
      "destination": "/",
      "permanent": true
    }
  ]
}
